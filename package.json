{
  "name": "astro-haze",
  "version": "1.2.0",
  "description": "A glassmorphism multi-purpose theme for Astro 7 - Blog, Portfolio & Landing Pages",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:test": "start-server-and-test dev http://localhost:4321 test",
    "test": "pwd",
    "update": "npm update",
    "upgrade:deps": "npx npm-check-updates -i && npm install",
    "sync:version": "git pull && node scripts/sync-version.js && git add package.json && git commit -m \"build: update version\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "astro-pagefind": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.2"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "withastro",
    "glassmorphism",
    "glass-ui",
    "blog",
    "portfolio",
    "landing-page",
    "multipurpose",
    "dark-mode",
    "mdx",
    "seo",
    "rss",
    "typescript",
    "accessible"
  ],
  "author": "kpab <kpablow1122@gmail.com>",
  "license": "MIT",
  "homepage": "https://kpab.github.io/astro-haze/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kpab/astro-haze.git"
  },
  "bugs": {
    "url": "https://github.com/kpab/astro-haze/issues"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
