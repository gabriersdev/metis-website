---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Container from '@/components/ui/Container.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { getPublishedPosts, splitFeatured } from '@/lib/posts';
import siteConfig from '@/site.config';
import { dictionary } from '../../../resources/dictionary';

const allPosts = await getPublishedPosts();
const perPage = siteConfig.blog.postsPerPage;

// Featured posts are pulled out of the pool before pagination, and
// page/[page].astro does the same split, so a featured post never
// reappears in a paginated grid regardless of where it falls in the
// full, date-sorted list.
const { featured, rest } = splitFeatured(allPosts);
const totalPages = Math.max(1, Math.ceil(rest.length / perPage));
const pagePosts = rest.slice(0, perPage);
---

<BaseLayout
  title={dictionary.pages.blog.title}
  description={dictionary.pages.blog.description}
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <section class="blog-hero">
      <Container>
        <GlassPanel variant="solid" padding="xl" className="hero-content">
          <h1 class="hero-title">Blog</h1>
          <p class="hero-description">
            Insights, tutoriais e atualizações sobre desenvolvimento web, design e tecnologia.
          </p>
        </GlassPanel>
      </Container>
    </section>

    {
      featured.length > 0 && (
        <section class="section">
          <Container>
            <h2 class="section-title">Destaques</h2>
            <PostGrid posts={featured} columns="two" />
          </Container>
        </section>
      )
    }

    <section class="section">
      <Container>
        <h2 class="section-title">
          {featured.length > 0 ? 'Últimas postagens' : 'Todas as postagens'}
        </h2>

        {
          allPosts.length === 0 ? (
            <GlassPanel variant="default" padding="xl" className="empty-state">
              <p>Nenhuma postagem no blog ainda. Volte em breve!</p>
            </GlassPanel>
          ) : (
            <>
              <PostGrid posts={pagePosts} />
              <Pagination
                currentPage={1}
                totalPages={totalPages}
                basePath="/blog"
              />
            </>
          )
        }
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh; /* fallback */
    min-height: 100dvh;
  }

  .section {
    padding: var(--space-3xl) 0;
  }

  .blog-hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    margin-bottom: var(--space-md);
    background: linear-gradient(
      135deg,
      var(--color-accent),
      var(--color-accent-light)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .empty-state {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .empty-state p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
    .section-title {
      font-size: var(--text-2xl);
    }
    .section {
      padding: var(--space-2xl) 0;
    }
  }
</style>
